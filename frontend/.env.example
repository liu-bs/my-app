# ─── 前端环境变量 ───

# JWT 密钥（开发环境可不设置，生产环境必须设置且长度 >= 32）
JWT_SECRET=dev-secret-at-least-32-characters-long-xxxx

# 站点基础 URL（用于 SEO metadata、sitemap、robots）
# Vercel 部署时设为你的生产域名，如 https://your-app.vercel.app
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Upstash Redis 免费版 — 本地开发不设置则自动使用内存 mock
# 在 https://upstash.com 注册免费账号，创建 Redis 数据库后填入以下变量：
# UPSTASH_REDIS_REST_URL=https://你的实例.upstash.io
# UPSTASH_REDIS_REST_TOKEN=你的token
# 也兼容 Vercel 集成 Upstash 时自动注入的变量名：
# KV_URL=rediss://default:密码@实例.upstash.io:6379
# KV_REST_API_TOKEN=你的token

# ─── 以下为可选项（有默认值）───
# JWT_EXPIRES_IN=7d
# BCRYPT_SALT_ROUNDS=10
# COOKIE_MAX_AGE_MS=604800000
# SEED_PASSWORD=SeedPass123!
