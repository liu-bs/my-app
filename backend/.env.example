# Server
PORT=3001
NODE_ENV=development

# Security
# 生产环境必须设置，且长度 >= 32
JWT_SECRET=your-256-bit-secret-min-32-chars-long
JWT_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=10

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:3004

# Cookie
COOKIE_MAX_AGE_MS=604800000

# Rate limiting (开发环境宽松值，生产环境通过环境变量覆盖)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=10000
AUTH_RATE_LIMIT_WINDOW_MS=300000
AUTH_RATE_LIMIT_MAX=1000

# Seed data
SEED_PASSWORD=SeedPass123!
